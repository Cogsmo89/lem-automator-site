# Add real values in Vercel: Project → Settings → Environment Variables.

# Required — Resend API key, create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Recommended — signs the contact form's anti-spam token.
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# If unset, the signing falls back to RESEND_API_KEY so the defence still works.
FORM_SECRET=

# Optional — Cloudflare Turnstile. Free, and invisible for most visitors.
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave both blank and the form skips Turnstile entirely; set both to enable it,
# with no code change needed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
